  { street: 'Har Street', gps: '13.1652,80.3072', condition: 'Level', height: 0, pedestrian: 'Medium', vehicle: 'Medium', risk: 'Medium', priority: 'Medium', remarks: 'Shopping st', interview: 'No', feedback: 'Not interviewed' },
  { street: 'Har Street', gps: '13.1644,80.3045', condition: 'Broken', height: 0, pedestrian: 'Medium', vehicle: 'Medium', risk: 'High', priority: 'High', remarks: 'Shopping st', interview: 'Yes', feedback: 'No issue reported' },

  { street: 'Sughos Street', gps: '13.1655,80.3075', condition: 'Broken', height: 0, pedestrian: 'Medium', vehicle: 'High', risk: 'High', priority: 'High', remarks: 'Hospital area', interview: 'Yes', feedback: 'Danger for vehicles' },

  { street: 'Raghavendra School Street', gps: '13.1655,80.3075', condition: 'Sunken', height: -3, pedestrian: 'High', vehicle: 'Medium', risk: 'High', priority: 'Medium', remarks: 'School area', interview: 'Yes', feedback: 'No issue reported' },
  { street: 'Raghavendra School Street', gps: '13.1656,80.3076', condition: 'Level', height: 0, pedestrian: 'High', vehicle: 'Medium', risk: 'Low', priority: 'Low', remarks: 'School area', interview: 'No', feedback: 'Not interviewed' },

  { street: 'Market Street', gps: '13.1656,80.3076', condition: 'Level', height: 0, pedestrian: 'High', vehicle: 'High', risk: 'Low', priority: 'Medium', remarks: 'Market road', interview: 'No', feedback: 'Not interviewed' },
  { street: 'Market Street', gps: '13.1656,80.3076', condition: 'Level', height: 0, pedestrian: 'High', vehicle: 'High', risk: 'Low', priority: 'Medium', remarks: 'Market road', interview: 'No', feedback: 'Not interviewed' },
  { street: 'Market Street', gps: '13.1656,80.3076', condition: 'Broken', height: 0, pedestrian: 'High', vehicle: 'High', risk: 'High', priority: 'Medium', remarks: 'Market road', interview: 'Yes', feedback: 'No issue reported' },
  { street: 'Market Street', gps: '13.1656,80.3076', condition: 'Level', height: 0, pedestrian: 'High', vehicle: 'High', risk: 'Low', priority: 'Medium', remarks: 'Market road', interview: 'No', feedback: 'Not interviewed' },
  { street: 'Market Street', gps: '13.1656,80.3076', condition: 'Sunken', height: -3, pedestrian: 'High', vehicle: 'High', risk: 'Medium', priority: 'Medium', remarks: 'Market road', interview: 'Yes', feedback: 'No issue reported' },
  { street: 'Market Street', gps: '13.1656,80.3076', condition: 'Level', height: 0, pedestrian: 'High', vehicle: 'High', risk: 'Low', priority: 'Medium', remarks: 'Market road', interview: 'No', feedback: 'Not interviewed' },
  { street: 'Market Street', gps: '13.1656,80.3076', condition: 'Level', height: 0, pedestrian: 'High', vehicle: 'High', risk: 'Low', priority: 'Medium', remarks: 'Market road', interview: 'No', feedback: 'Not interviewed' },
  { street: 'Market Street', gps: '13.1656,80.3076', condition: 'Broken', height: 0, pedestrian: 'High', vehicle: 'High', risk: 'High', priority: 'Medium', remarks: 'Market road', interview: 'Yes', feedback: 'No issue reported' },
];

const total = surveyData.length;

const conditionCounts = surveyData.reduce((acc, row) => {
  acc[row.condition] = (acc[row.condition] || 0) + 1;
  return acc;
}, {});

const riskCounts = surveyData.reduce((acc, row) => {
  acc[row.risk] = (acc[row.risk] || 0) + 1;
  return acc;
}, {});

const priorityCounts = surveyData.reduce((acc, row) => {
  acc[row.priority] = (acc[row.priority] || 0) + 1;
  return acc;
}, {});

const unevenRows = surveyData.filter(
  (row) => row.condition === 'Raised' || row.condition === 'Sunken'
);

const defectiveRows = surveyData.filter(
  (row) =>
    row.condition === 'Raised' ||
    row.condition === 'Sunken' ||
    row.condition === 'Broken'
);

const highRiskRows = surveyData.filter((row) => row.risk === 'High');

const highPriorityRows = surveyData.filter((row) => row.priority === 'High');

const streetNames = [...new Set(surveyData.map((row) => row.street))];

const streetStats = streetNames
  .map((street) => {
    const rows = surveyData.filter((row) => row.street === street);

    const uneven = rows.filter(
      (row) => row.condition === 'Raised' || row.condition === 'Sunken'
    ).length;

    const defective = rows.filter(
      (row) =>
        row.condition === 'Raised' ||
        row.condition === 'Sunken' ||
        row.condition === 'Broken'
    ).length;

    const highRisk = rows.filter((row) => row.risk === 'High').length;

    const averageHeight =
      rows.reduce((sum, row) => sum + row.height, 0) / rows.length;

    return {
      street,
      total: rows.length,
      uneven,
      defective,
      highRisk,
      averageHeight: Number(averageHeight.toFixed(2)),
    };
  })
  .sort((a, b) => b.uneven - a.uneven);

const feedbackCounts = surveyData.reduce((acc, row) => {
  acc[row.feedback] = (acc[row.feedback] || 0) + 1;
  return acc;
}, {});

const pedestrianRisk = ['Low', 'Medium', 'High'].map((traffic) => ({
  traffic,
  low: surveyData.filter(
    (row) => row.pedestrian === traffic && row.risk === 'Low'
  ).length,
  medium: surveyData.filter(
    (row) => row.pedestrian === traffic && row.risk === 'Medium'
  ).length,
  high: surveyData.filter(
    (row) => row.pedestrian === traffic && row.risk === 'High'
  ).length,
}));

const vehicleRisk = ['Low', 'Medium', 'High'].map((traffic) => ({
  traffic,
  low: surveyData.filter(
    (row) => row.vehicle === traffic && row.risk === 'Low'
  ).length,
  medium: surveyData.filter(
    (row) => row.vehicle === traffic && row.risk === 'Medium'
  ).length,
  high: surveyData.filter(
    (row) => row.vehicle === traffic && row.risk === 'High'
  ).length,
}));

const conditionOrder = ['Level', 'Raised', 'Sunken', 'Broken'];
const riskOrder = ['Low', 'Medium', 'High'];

const defectivePercentage = ((defectiveRows.length / total) * 100).toFixed(1);
const highRiskPercentage = ((highRiskRows.length / total) * 100).toFixed(1);
---

