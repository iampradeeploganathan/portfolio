        </div>
      </div>

      <div class="risk-grid">
        {riskOrder.map((risk) => {
          const count = riskCounts[risk] || 0;
          const percentage = ((count / total) * 100).toFixed(1);

          return (
            <div class={`risk-card risk-${risk.toLowerCase()}`}>
              <span>{risk} Risk</span>
              <strong>{count}</strong>
              <small>{percentage}% of observations</small>
            </div>
          );
        })}
      </div>

      <div class="risk-explanation">
        <strong>How risk was classified</strong>
        <p>
          Risk was determined in the project using cover condition,
          pedestrian traffic, vehicle traffic and on-site observations.
          These classifications are part of this field survey and are not
          official municipal or engineering safety ratings.
        </p>
      </div>
    </section>

    <!-- HIGH RISK -->
    <section class="section">
